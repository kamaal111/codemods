// Rstest Snapshot v1

exports[`Joi check to Zod enum 1`] = `
"import Joi from 'joi';

enum Job {
  Developer = 'developer',
  DevOps = 'devops',
  Designer = 'designer',
}

export const employee = Joi.object().keys({
  job: Joi.string().enum(Job),
});
"
`;

exports[`Joi check to Zod enum passes arbitrary spread values without a cast 1`] = `
"import Joi from 'joi';

const statuses = getStatuses();
const schema = Joi.string().enum(statuses);
"
`;

exports[`Joi check to Zod enum with literal values 1`] = `
"import Joi from 'joi';

export const employee = Joi.object().keys({
  status: Joi.string().enum(['active', 'inactive', 'pending']),
});
"
`;

exports[`Joi check to Zod enum with literal values and required 1`] = `
