{
  "name": "@kamaalio/codemods",
  "version": "0.0.1",
  "description": "A collection of codemods, runnable as a single CLI.",
  "keywords": [
    "ast-grep",
    "codemod",
    "joi",
    "migration",
    "zod"
  ],
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamaal111/codemods.git"
  },
  "bin": "./bin/run.mjs",
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "build": "pnpm run compile",
    "compile": "tsc",
    "clean:build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:u": "vitest run --update",
    "test:example": "vitest run --config example/joi-to-zod/vitest.config.ts",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project tsconfig.test.json",
    "type-check:example": "tsc --noEmit --project example/joi-to-zod/tsconfig.json",
    "lint": "oxlint",
    "lint:example": "oxlint example/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run type-check:test && pnpm run check:example-snapshot",
    "preview": "node ./bin/dev.mjs joi-to-zod test/resources --dry",
    "transform:example": "node ./scripts/cli-entry.ts joi-to-zod example/joi-to-zod",
    "transform:example:jest": "node ./scripts/cli-entry.ts jest-to-vitest example/jest-to-vitest",
    "generate:example-snapshot": "node ./scripts/generate-example-snapshot.ts --write",
    "check:example-snapshot": "node ./scripts/generate-example-snapshot.ts --check",
    "new:codemod": "node ./scripts/new-codemod.ts",
    "release": "node ./scripts/publish.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.3",
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1",
    "neverthrow": "^8.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@kamaal111/oxlint-plugin-anti-slop": "^0.0.3",
    "@oxlint/plugins": "^1.82.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "joi": "^18.2.8",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
