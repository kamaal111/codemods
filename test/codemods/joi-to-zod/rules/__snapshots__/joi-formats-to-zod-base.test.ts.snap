exports[`hoists each nested schema format independently 1`] = `
"import Joi from 'joi';

const schema = Joi.object().keys({
  id: Joi.uuid(),
  colour: Joi.hex().min(6),
  contact: Joi.email(),
});
"
`;

exports[`hoists the format even when it is not adjacent to the primitive 1`] = `
